[user]
	name = Jean-Christophe Gay
{% if yadm.class == "Work" %}
	email = jean-christophe.gay@vidal.fr
{% else %}
	email = contact@jeanchristophegay.com
{% endif %}
[credential]
	helper = osxkeychain
[color]
	ui = auto
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[help]
	autocorrect = prompt
[commit]
	verbose = true
[alias]
	st = status
	ci = commit
	lg = log --graph --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%an %cr)%Creset'
	standup = !git-standup
	export = !f() { git archive --format zip --output $1 $2; }; f
	ulg = !(git fetch && git lg ..@{u})
	llg = !(git lg @{u}..)
	ignored = clean -ndX
	ready = rebase -i @{u}
	delete-merged = branch --delete-merged */*
	changelog = "!f() { git log $1...$2 --pretty=format:\"- %s ([%h](http://github.com/jcgay/$3/commit/%H))  \"; }; f"
[core]
	pager = delta
	whitespace = -trailing-space
	excludesfile = ~/.gitignore_global
	editor = micro
	trustctime = false
[diff]
	mnemonicPrefix = true
	wordRegex = .
	algorithm = histogram
	colorMoved = zebra
[fetch]
	recurseSubmodules = on-demand
	prune = true
	pruneTags = true
	all = true
	followRemoteHEAD = always
[grep]
	extendedRegexp = true
[log]
	abbrevCommit = true
	follow = true
[merge]
	conflictStyle = zdiff3
	tool = p4merge
[mergetool]
	keepBackup = false
	keepTemporaries = false
	prompt = false
[merge "compote"]
	name = Écrase les poms proprement
	driver = compote %O %A %B
[pull]
	rebase = merges
[push]
	default = upstream
	autoSetupRemote = true
	followTags = true
[rerere]
	autoupdate = true
	enabled = true
[status]
	submoduleSummary = true
	showUntrackedFiles = all
	compareBranches = @{upstream} @{push}
[rebase]
	autostash = true
	autoSquash = true
	updateRefs = true
[blame]
	ignoreRevsFile = :(optional).git-blame-ignore-revs
[stash]
	index = true
[init]
	defaultBranch = main
[advice]
	skippedCherryPicks = false
[interactive]
	diffFilter = delta --color-only
[delta]
	pager = less -FR
	navigate = true
	side-by-side = false
	line-numbers = true
	syntax-theme = Monokai Extended
