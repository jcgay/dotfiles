#!/bin/bash
set -e

echo "=== yadm bootstrap ==="

# Demande la classe si non configurée
if [ -z "$(yadm config local.class)" ]; then
  echo "Quelle est la classe de cette machine ?"
  select class in "Work" "Personal"; do
    yadm config local.class "$class"
    yadm alt
    break
  done
fi

# Installe Homebrew si absent
if ! command -v brew &>/dev/null; then
  echo "Installation de Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Trust brew tap
echo "Ajout des tap de confiance..."
brew trust jcgay/jcgay
brew trust mvndaemon/homebrew-mvnd
brew trust wagoodman/dive
brew trust moul/moul
brew trust mthmulders/tap
brew trust jakewharton/repo
brew trust raullenchai/rapid-mlx
brew trust static-var/tap
brew trust avivsinai/tap
brew trust plannotator/tap
brew trust AlexsJones/llmfit

# Installe toutes les dépendances via Brewfile
echo "Installation des formules Homebrew..."
brew bundle --global

# git lfs
git lfs install

# Change le shell par défaut vers fish
# Le préfixe Homebrew diffère selon l'archi : /opt/homebrew (Apple Silicon), /usr/local (Intel)
FISH_PATH="$(brew --prefix)/bin/fish"
if [ "$SHELL" != "$FISH_PATH" ]; then
  echo "Changement du shell vers fish..."
  if ! grep -q "$FISH_PATH" /etc/shells; then
    echo "$FISH_PATH" | sudo tee -a /etc/shells
  fi
  chsh -s "$FISH_PATH"
fi

# Répertoire workspace Go
echo "Création du workspace Go..."
mkdir -p ~/dev/golang/{src,bin,pkg}

# SonarQube CLI, machines de travail seulement (pas de formule brew — installe dans ~/.local/share/sonarqube-cli)
if [ "$(yadm config local.class)" = "Work" ] && [ ! -x "$HOME/.local/share/sonarqube-cli/bin/sonar" ]; then
  echo "Installation de SonarQube CLI..."
  curl -o- https://raw.githubusercontent.com/SonarSource/sonarqube-cli/refs/heads/master/user-scripts/install.sh | bash
fi

# jira-merged : passe en Done Dev les tickets de mes PR mergées. bootout d'abord, pour pouvoir rejouer.
if [ "$(yadm config local.class)" = "Work" ]; then
  launchctl bootout "gui/$(id -u)/fr.jcgay.jira-merged" 2>/dev/null || true # pas encore chargé : code 3, et set -e
  launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/fr.jcgay.jira-merged.plist
fi

# wt-prune : chaque matin, supprime les worktrees et branches déjà mergés. bootout d'abord, pour pouvoir rejouer.
launchctl bootout "gui/$(id -u)/fr.jcgay.wt-prune" 2>/dev/null || true # pas encore chargé : code 3, et set -e
launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/fr.jcgay.wt-prune.plist

# mise — installe tous les outils JVM (Java, Gradle, Kotlin, etc.)
echo "Installation des outils JVM via mise..."
mise install

# SDK Android (sdkmanager vient du cask android-commandlinetools, Java vient de mise)
echo "Installation du SDK Android..."
mise exec -- sdkmanager --licenses
mise exec -- sdkmanager "platforms;android-36" "build-tools;36.0.0" "platform-tools"

# Fisher (fish plugin manager)
echo "Installation de fisher et plugins fish..."
fish -c 'curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && fisher install < ~/.config/fish/fish_plugins'

# Worktrunk (wt vient du Brewfile) : fonction fish générée pour que `wt switch` fasse le cd
wt config shell install --yes || true

# Claude Code — marketplaces, plugins, serveurs MCP (claude vient du Brewfile)
# `claude --version` plutôt que `command -v` : ~/.local/bin/claude est le wrapper,
# trouvé même sans Claude Code (il sort alors en 127).
if claude --version &>/dev/null; then
  echo "Configuration de Claude Code (plugins + MCP)..."

  # Marketplaces tierces (claude-plugins-official est déjà connue par défaut)
  claude plugin marketplace add DietrichGebert/ponytail || true
  claude plugin marketplace add obra/superpowers-marketplace || true
  claude plugin marketplace add jcgay/glane || true
  claude plugin marketplace add avivsinai/skills-marketplace || true
  claude plugin marketplace add pbakaus/impeccable || true
  claude plugin marketplace add blader/humanizer || true
  claude plugin marketplace add gradle/gradle-skills || true
  claude plugin marketplace add docker/skills || true

  # Sans lancement préalable de claude, l'index local de claude-plugins-official
  # n'est pas encore fetché → install échoue. On le rafraîchit d'abord.
  claude plugin marketplace update claude-plugins-official || true

  # Plugins (scope user par défaut) — || true pour rester ré-exécutable
  for plugin in \
    superpowers@superpowers-marketplace \
    context7@claude-plugins-official \
    frontend-design@claude-plugins-official \
    ponytail@ponytail \
    glane@glane \
    jk@avivsinai-marketplace \
    impeccable@impeccable \
    humanizer@humanizer \
    gradle-skills@gradle-skills \
    docker-skills@docker \
    claude-md-management@claude-plugins-official; do
    claude plugin install "$plugin" || true
  done

  # Machines de travail seulement : plugins Vidal (base Merlin, recherche de code blaise) et SonarQube.
  # Le plugin blaise installe sa CLI dans ~/.local/bin à chaque démarrage de session (VPN).
  if [ "$(yadm config local.class)" = "Work" ]; then
    claude plugin marketplace add 'softwarevidal/merlin-search#marketplace' || true
    claude plugin install merlin@vidal || true
    claude plugin marketplace add 'softwarevidal/blaise#marketplace' || true
    claude plugin install blaise@blaise || true
    claude plugin install sonarqube@claude-plugins-official || true
    # hooks sonar-secrets et serveur MCP (après `sonar auth login`)
    "$HOME/.local/share/sonarqube-cli/bin/sonar" integrate claude --non-interactive || true
  fi

  # Plannotator : binaire, plugin Claude et skills plannotator-* (le TUI vient du Brewfile)
  curl -fsSL https://plannotator.ai/install.sh | bash -s -- --non-interactive --no-extras || true

  # rtk : hook Bash qui compresse la sortie des commandes, RTK.md importé par ~/.claude/CLAUDE.md
  rtk init -g --auto-patch || true

  # build-brief : section de ~/.claude/CLAUDE.md, marketplace locale et plugin
  # (interactif ; CLAUDE.md doit exister, d'où le passage après rtk)
  build-brief --global || true

  # Worktrunk : hooks WorktreeCreate/WorktreeRemove (les worktrees des agents suivent
  # worktree-path de ~/.config/worktrunk/config.toml) et marqueurs d'activité dans `wt list`.
  # Pas install-statusline : il remplacerait statusline-command.sh
  wt config plugins claude install --yes || true

  # Herdr : hook qui donne l'état et la session de Claude Code (reprise après redémarrage)
  herdr integration install claude || true

  # Skills Playwright Agent CLI (la CLI vient de mise : npm:@playwright/cli)
  # `install --skills` doit être lancé depuis le HOME → sous-shell avec cd
  (cd "$HOME" && mise exec -- playwright-cli install --skills) || true

  # Skills hors plugins via `npx skills` (node vient de mise)
  mise exec -- npx -y skills add vercel-labs/agent-skills -s web-design-guidelines -g -a claude-code -y || true
  mise exec -- npx -y skills add Leonxlnx/taste-skill -s design-taste-frontend -g -a claude-code -y || true
  mise exec -- npx -y skills add tt-a1i/archify -s archify -g -a claude-code -y || true
  mise exec -- npx -y skills add GoogleChrome/modern-web-guidance -s modern-web-guidance -g -a claude-code -y || true

  # codebase-memory-mcp : binaire ~/.local/bin, serveur MCP, skill et hooks cbm-*
  curl -fsSL https://raw.githubusercontent.com/DeusData/codebase-memory-mcp/main/install.sh \
    | bash -s -- --clients=claude || true
  # Retire son hook SessionStart : il répète les instructions que le serveur MCP envoie déjà
  cbm_settings="$HOME/.claude/settings.json"
  if [ -f "$cbm_settings" ]; then
    jq 'if .hooks.SessionStart then .hooks.SessionStart |= map(
          .hooks = [(.hooks // [])[] | select((.command // "") | contains("cbm-session-reminder") | not)]
          | select(.hooks | length > 0)) else . end' \
      "$cbm_settings" > "$cbm_settings.tmp" && mv "$cbm_settings.tmp" "$cbm_settings" \
      || { rm -f "$cbm_settings.tmp"; echo "⚠️  $cbm_settings illisible — rappel SessionStart de codebase-memory non retiré."; }
  fi

  # Hook signature "🤖 Jean-Claude" sur gh (settings.json n'est pas suivi par yadm)
  settings="$HOME/.claude/settings.json"
  hook='~/.claude/hooks/github-signature'
  [ -f "$settings" ] || echo '{}' > "$settings"
  if ! grep -qF "$hook" "$settings"; then
    jq --arg c "$hook" '
      .hooks.PreToolUse //= [] |
      if any(.hooks.PreToolUse[]; .matcher == "Bash")
      then (.hooks.PreToolUse[] | select(.matcher == "Bash") | .hooks) += [{type: "command", command: $c, timeout: 5}]
      else .hooks.PreToolUse += [{matcher: "Bash", hooks: [{type: "command", command: $c, timeout: 5}]}]
      end' "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings" \
      || { rm -f "$settings.tmp"; echo "⚠️  $settings illisible — hook github-signature non enregistré."; }
  fi

  # Réglages, status line et mods (suivis par yadm) ; une valeur déjà présente dans settings.json gagne
  jq '{
    model: "opus",
    theme: "auto",
    autoContinueAtUsageLimit: false,
    skipDangerousModePermissionPrompt: true,
    skipWorkflowUsageWarning: true,
    statusLine: {type: "command", command: "bash ~/.claude/statusline-command.sh"}
  } + . | del(.subagentStatusLine)
    | .env.CLAUDE_CODE_PLUGIN_DIRS |= reduce $mods[] as $d (.;
        if (. // "") == "" then $d elif (split(":") | index($d)) then . else . + ":" + $d end)
  ' --argjson mods '["~/.claude/mods/subagent-band", "~/.claude/mods/commit-guard"]' "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings" \
    || { rm -f "$settings.tmp"; echo "⚠️  $settings illisible — réglages Claude non appliqués."; }

  # Plugins et skills utiles seulement dans certains dépôts : coupés ici, le wrapper
  # ~/.local/bin/claude les rallume selon les fichiers du dépôt. Ces valeurs gagnent :
  # `claude plugin install` vient de les activer.
  if defaults=$("$HOME/.local/bin/claude" --wrapper-defaults) && [ -n "$defaults" ]; then
    jq --argjson d "$defaults" \
      '.enabledPlugins += $d.enabledPlugins | .skillOverrides = ((.skillOverrides // {}) + $d.skillOverrides)' \
      "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings" \
      || { rm -f "$settings.tmp"; echo "⚠️  $settings illisible — plugins par projet non coupés."; }
  else
    echo "⚠️  ~/.local/bin/claude --wrapper-defaults n'a rien donné — plugins par projet non coupés."
  fi

  # Auto-update des marketplaces GitHub : désactivé par défaut hors marketplaces officielles
  # https://code.claude.com/docs/en/plugins/loading#when-auto-update-runs
  jq '(.extraKnownMarketplaces[]? | select(.source.source == "github") | .autoUpdate) = true' \
    "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings" \
    || { rm -f "$settings.tmp"; echo "⚠️  $settings illisible — auto-update des marketplaces non activé."; }
else
  echo "ℹ️  CLI 'claude' absente — section Claude Code ignorée (relancer après installation)."
fi

# Workflows Alfred — import interactif (nécessite Alfred lancé + clic "Import" par workflow)
echo ""
read -p "Installer les workflows Alfred (~/.local/bin/install-alfred-workflows) ? [y/N] " confirm_alfred
if [[ "$confirm_alfred" == "y" || "$confirm_alfred" == "Y" ]]; then
  fish "$HOME/.local/bin/install-alfred-workflows" || true
else
  echo "ℹ️  Skipping. Relancer manuellement avec : install-alfred-workflows"
fi

# Personnalisation macOS (defaults write) — opinionné, nécessite sudo
echo ""
read -p "Appliquer la personnalisation macOS (~/.config/yadm/macos-defaults.sh) ? [y/N] " confirm_macos
if [[ "$confirm_macos" == "y" || "$confirm_macos" == "Y" ]]; then
  bash "$HOME/.config/yadm/macos-defaults.sh" || true
else
  echo "ℹ️  Skipping. Relancer manuellement avec : bash ~/.config/yadm/macos-defaults.sh"
fi

# Restauration des configs apps via mackup
echo ""
echo "⚠️  Assurez-vous que Dropbox est synchronisé avant de continuer."
read -p "Continuer avec mackup restore ? [y/N] " confirm
if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
  mackup restore
  echo "✅  mackup restore terminé."
else
  echo "ℹ️  Skipping mackup restore. Relancer manuellement avec : mackup restore"
fi

echo ""
echo "✅  Bootstrap terminé !"
echo "ℹ️  Relancer le shell pour appliquer tous les changements."
