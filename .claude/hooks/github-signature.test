#!/usr/bin/env bash
# Self-check for github-signature: ./github-signature.test (silent on success)
cd "$(dirname "$0")"
dir=$(mktemp -d); signed=$dir/b\ c.md; printf 'b\n\n🤖 Jean-Claude\n' > "$signed"; cp "$signed" "$dir/gh"
fail=0
t() { got=$(jq -n --arg c "$2" --arg d "$dir" '{tool_input:{command:$c},cwd:$d}' | ./github-signature | jq -r '.hookSpecificOutput.permissionDecision // "allow"')
      got=${got:-allow}; [ "$got" = "$1" ] || { echo "FAIL want $1 got $got: $2"; fail=1; }; }
t deny  'gh pr comment 12 --body "hello"'
t allow 'gh pr comment 12 --body "hello

🤖 Jean-Claude"'
t deny  'gh pr create --fill'
t allow 'gh pr create --web'
t deny  'gh issue comment 5 -b hi'
t deny  'gh pr view 3 && gh pr comment 3 -b hi'
t deny  'rtk proxy gh pr review 3 --comment -b hi'
t deny  'gh -R o/r pr comment 1 -b hi'
t deny  'gh release create v1 --notes x'
t allow 'gh pr review 3 --approve'
t allow 'gh pr edit 3 --title x'
t allow 'gh pr view 3'
t allow 'gh pr merge 3 -b x'
t allow "gh pr comment 1 -F '$signed'"
t allow "gh pr create --title x --body-file \"$signed\""
t allow 'yadm commit -m "Sign gh pr create output"'
t allow 'git commit -F - <<X
Block gh issue create -b x
X'
t allow 'cat <<X > x.md
gh pr create --body x
X'
t deny  'cd ~/src/repo
gh pr comment 1 --body "x"'
t deny  'cat <<X
text
X
gh issue comment 1 -b x'
t allow 'gh pr comment 1 -F - <<'"'"'X'"'"'
body

🤖 Jean-Claude
X'
t allow 'git commit -F - <<-X
	gh pr comment 1 -b x
	X'
t allow 'gh pr edit 3 --add-label bug && git log -n 3'
t allow 'gh pr review 3 --approve && wc -l -n'
t allow 'gh pr edit 3 --title t; gh api x -F foo=bar'
t allow 'git commit -m "Fix; gh pr comment 3 -b x"'
t allow 'gh pr create --title t -w'
t deny  'FOO=1 gh pr comment 3 -b x'
t deny  'gh --repo=o/r pr comment 1 --body=x'
t deny  'x=$(gh pr comment 1 -b hi)'
t allow "gh pr comment 1 --body-file='$signed'"
t deny  'gh issue comment 1 \
-b x'
t deny  'gh \
  pr comment 1 -b x'
t deny  'echo "Créé : $(gh pr comment 1 -b x)"'
t allow 'echo "$(gh pr view 1)"; git log -n 3'
t deny  'echo `gh pr comment 1 -b x`'
t deny  'for n in 1 2; do gh pr comment $n -b x; done'
t deny  'env gh pr comment 1 -b x'
t deny  'gh -R=o/r pr comment 1 -b x'
t deny  'gh -Ro/r pr comment 1 -b x'
t deny  'gh pr comment 1 -bhello'
t allow 'gh pr comment 1 -F "b c.md"'
t allow 'gh pr comment 1 -F gh'
t allow "gh pr comment 1 -F'$signed'"
exit $fail
