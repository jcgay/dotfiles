#!/usr/bin/env bash
# Self-check for the usage file statusline-command.sh writes for Herdr: ./statusline-command.test
# (silent on success). Needs jq.
cd "$(dirname "$0")" || exit 1
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
export HOME=$T TMPDIR=$T
file=$T/.cache/claude-usage.json

fail=0
# run <5h reset> <5h %> <7d %>: one status line render with these limits.
run() {
  printf '{"workspace":{"current_dir":"%s"},"rate_limits":{"five_hour":{"used_percentage":%s,"resets_at":%s},"seven_day":{"used_percentage":%s,"resets_at":2000000000}}}' \
    "$T" "$2" "$1" "$3" | bash ./statusline-command.sh >/dev/null
}
# expect <name> <5h %> <7d %>: what the file holds now.
expect() {
  got=$(jq -r '"\(.five_hour.used_percentage) \(.seven_day.used_percentage)"' "$file" 2>/dev/null)
  [ "$got" = "$2 $3" ] || { echo "FAIL $1: got '$got', want '$2 $3'"; fail=1; }
}

run 1900000000 10 5;  expect "no file yet: written" 10 5
run 1900000000 30 7;  expect "same window, higher: written" 30 7
run 1900000000 10 5;  expect "idle session, same window, lower: kept" 30 7
run 1800000000 80 5;  expect "idle session, older window: kept" 30 7
run 1900018000 2 8;   expect "next window: written" 2 8
run 1900018000 2 9;   expect "7 days higher only: written" 2 9
mtime() { date -r "$file" +%s; }
touch -t 202001010000 "$file"; old=$(mtime)
run 1900018000 2 9;   [ "$(mtime)" = "$old" ] || { echo "FAIL same figures: rewritten"; fail=1; }
echo '{"five_hour":' > "$file"
run 1900018000 2 9;   expect "unreadable file: replaced" 2 9
ls "$T" | grep -q '^claude-usage\.' && { echo "FAIL temp file left in TMPDIR"; fail=1; }
exit $fail
