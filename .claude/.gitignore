# ~/.claude is mostly local state + plugin-managed files.
# Ignore everything, whitelist only hand-authored, portable config.
# (git still only tracks what's `add`-ed; this guards against `add -A`.)
*
!.gitignore
!statusline-command.sh
!statusline-command.test
!mods/
!mods/subagent-band/
!mods/subagent-band/.claude-plugin/
!mods/subagent-band/.claude-plugin/plugin.json
!mods/subagent-band/hooks/
!mods/subagent-band/hooks/*
!mods/subagent-band/types/
!mods/subagent-band/types/*
!mods/commit-guard/
!mods/commit-guard/.claude-plugin/
!mods/commit-guard/.claude-plugin/plugin.json
!mods/commit-guard/hooks/
!mods/commit-guard/hooks/*
!.ponytail-band
!rules/
!rules/git-commit.md
!rules/github.md
!rules/skill-feedback.md
!docs/
!docs/*.md
!scripts/
!scripts/gh-pr-upsert-comment
!scripts/gh-pr-upsert-comment.test
!hooks/
!hooks/github-signature
!hooks/github-signature.test
!skills/
!skills/pr-risk/
!skills/pr-risk/*
!skills/pr-demo/
!skills/pr-demo/**
!skills/pr-review/
!skills/pr-review/**
!skills/inspecting-dockersw-containers/
!skills/inspecting-dockersw-containers/SKILL.md##class.Work
