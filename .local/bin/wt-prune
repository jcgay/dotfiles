#!/usr/bin/env bash
#
# wt-prune
#
# Runs `wt step prune` in every repo that has a worktree under ~/dev/agents-worktree: agents and
# start-work leave them behind. In each such repo it removes the worktrees, with their branches,
# and the local branches without a worktree, that are already integrated into the default branch.
# That includes a worktree whose branch has no commit of its own yet ("ancestor of master").
# Run by launchd (~/Library/LaunchAgents/fr.jcgay.wt-prune.plist) every morning with --foreground.
# Arguments go to `wt step prune`: `wt-prune --dry-run` shows what would go.
#
# wt skips a worktree younger than a day, one with changes (untracked files included), a detached
# one (so the PR watch's *-watch worktrees stay), and, without --yes, one whose project hooks
# were never approved.

set -uo pipefail

# One main worktree per repo, the first one `git worktree list` gives (the yadm repo's git dir works too).
# Three levels: a branch name with a slash keeps it in the path (ordostruct/feat/x).
for d in ~/dev/agents-worktree/*/*/ ~/dev/agents-worktree/*/*/*/; do
  git -C "$d" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p' || true # not a repo: pipefail would make it the exit code
done | sort -u | {
  failed=()
  while IFS= read -r main; do
    echo "== $main ($(date '+%F %T'))"
    # yadm: wt takes $HOME (core.worktree, no .git) for the main worktree, and its `git rev-parse
    # --git-common-dir` there fails every worktree removal. Remove those it picks with git first.
    if [ "$(git --git-dir "$main" config --bool yadm.managed 2>/dev/null)" = true ] && [[ " $* " != *" --dry-run "* ]]; then
      while IFS=$'\t' read -r path branch; do
        git --git-dir "$main" worktree remove "$path" && git --git-dir "$main" branch -qD "$branch" &&
          echo "✓ Removed $branch worktree & branch" || failed+=("${main##*/}")
      done < <(wt -C "$main" step prune --dry-run --format=json "$@" | jq -r '.[] | select(.kind == "worktree" and .branch) | [.path, .branch] | @tsv')
    fi
    wt -C "$main" step prune "$@" ||{ echo "wt-prune: failed in $main" >&2; failed+=("${main##*/}"); }
  done
  # Nobody reads the log: say it now. Exit 1 also shows in `launchctl print` (checked by `dot`).
  if [ ${#failed[@]} -gt 0 ]; then
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' \
      "wt-prune a échoué" "${failed[*]}, voir ~/Library/Logs/wt-prune.log"
    exit 1
  fi
}
